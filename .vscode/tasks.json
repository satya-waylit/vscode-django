// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      // Vite reports its own errors; there is no matcher for its output.
      "problemMatcher": [],
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "npm",
      "script": "watch-tests",
      "isBackground": true,
      "problemMatcher": [
        "$tsc-watch"
      ],
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    },
    {
      "label": "watch-all",
      "dependsOn": [
        "npm: watch",
        "npm: watch-tests"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
